# Required in Vercel Preview before building. Never reuse production values.
NEXT_PUBLIC_SUPABASE_URL=https://gsudlmrmrefqqodpdeug.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only required by server-side Inbox webhooks. Never expose in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
NODE_ENV=development
PORT=4000
# AI brain. Default: self-hosted open model (no paid AI API). See docs/SELF-HOSTED-AI.md.
#   local  -> any OpenAI-compatible server you run yourself (Ollama, vLLM, llama.cpp, LM Studio)
#   openai -> optional paid fallback (needs AI_API_KEY)
AI_PROVIDER=local
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5:7b-instruct
# Optional for local: only if your model server is protected with a key (vLLM --api-key).
AI_API_KEY=
# Optional tuning for local models.
AI_TIMEOUT_MS=120000
AI_TEMPERATURE=0.2
# json_schema (default) or json_object if your server does not support JSON-schema output.
AI_JSON_MODE=json_schema
VOICE_PROVIDER=
VOICE_API_KEY=
VOICE_FROM_NUMBER=
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=
DATABASE_URL=
INTERNAL_API_KEY=
WEBHOOK_SIGNING_SECRET=

# EngageX -> SAVRDH AI webhook/manual sync. Server-side only.
ENGAGEX_WEBHOOK_SECRET=
ENGAGEX_PROJECT_URL=
ENGAGEX_SERVICE_ROLE_KEY=
ENGAGEX_WORKSPACE_ID=

# Production deployment requires NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY in Vercel Production env.
